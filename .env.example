# FleetFlow Environment Configuration Example

# Port the HTTP server listens on (Cloud Run sets PORT automatically)
PORT=8080

# Environment mode (development / production)
ENV=development

# Optional default graph path override
GRAPH_PATH=data/graph.json

# Optional: the key the process presents for its own simulated traffic. With it
# set, a simulation run's fleet vehicles reach the routing engine over the public
# API, as an external client does, instead of calling it in-process. Issue one
# with `fleetflow -issue-key simulator` and paste the printed value here; leave it
# empty and a run still works, but its traffic never crosses the network.
SIM_API_KEY=

# Local development database. Start it with `docker compose up -d`.
# Development and production are separate databases with separate credentials.
# The dev MCP connects as POSTGRES_USER against 127.0.0.1 only (the dev database
# is deliberately writable); production is reached through its own DATABASE_URL
# and never from this repo. See AGENTS.md "Database".
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=fleetflow
POSTGRES_USER=fleetflow
POSTGRES_PASSWORD=change-me
# Optional read-only role, kept for inspection. The dev MCP does not use it.
POSTGRES_RO_USER=fleetflow_ro
POSTGRES_RO_PASSWORD=change-me
