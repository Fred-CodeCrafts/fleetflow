# FleetFlow Environment Configuration Example

# Port the HTTP server listens on (Cloud Run sets PORT automatically)
PORT=8080

# Environment mode (development / production)
ENV=development

# OSRM server used for actual driving routes (prepare the Jakarta OSM extract
# with scripts/osrm/build-jakarta.ps1, then start the osrm compose service).
OSRM_URL=http://127.0.0.1:5000

# Require an API key on the routes that change fleet data. Leave unset for a local
# demonstration; set true for a public deployment. /readyz reports which mode runs.
# REQUIRE_OPERATOR_KEY=false

# Lowest log level the process writes: debug, info, warn or error. Info carries
# one line per request and simulation-run lifecycle; debug adds per-run detail.
# Production writes JSON and development writes text, chosen from ENV.
LOG_LEVEL=info

# Optional local SUMO scenarios. Build the network with
# scripts/sumo/build-jakarta.ps1 before setting SUMO_NETWORK.
# SUMO_HOME=C:\Program Files (x86)\Eclipse\Sumo
# SUMO_NETWORK=C:\path\to\Fleetflow\data\networks\generated\jakarta-dki.net.xml
# SUMO_PYTHON=python
# SUMO_WORK_DIR=C:\path\to\sumo-temp

# Local development database. Start it with `docker compose up -d`.
# Development and production are separate databases with separate credentials.
# The dev MCP connects as POSTGRES_USER against 127.0.0.1 only (the dev database
# is deliberately writable); production is reached through its own DATABASE_URL
# and never from this repo. See AGENTS.md "Database".
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=fleetflow
POSTGRES_USER=fleetflow
POSTGRES_PASSWORD=change-me
# Optional read-only role, kept for inspection. The dev MCP does not use it.
POSTGRES_RO_USER=fleetflow_ro
POSTGRES_RO_PASSWORD=change-me
